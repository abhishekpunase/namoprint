# Backend URL for local development
VITE_DEV_API_TARGET=http://localhost:5000

# direct (default): fetch http://localhost:5000/api — shows port 5000 in DevTools
# proxy: fetch /api on Vite port — Vite proxies to VITE_DEV_API_TARGET
VITE_DEV_API_MODE=direct

# Production build only — leave unset in local dev
# VITE_API_BASE_URL=

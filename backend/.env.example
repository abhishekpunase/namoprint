NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MONGO_URI=mongodb://127.0.0.1:27017/omgs_printingwatch
# Atlas example (whitelist your IP in Network Access):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/omgs_printingwatch?retryWrites=true&w=majority
# Dev fallback when Atlas/local Mongo fails or USE_MEMORY_MONGO=true:
USE_MEMORY_MONGO=false

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_SETUP_SECRET=change_this_admin_setup_secret

COOKIE_SECRET=change_this_cookie_secret
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=40

MAX_IMAGE_MB=25
LOCAL_UPLOAD_PUBLIC_URL=http://localhost:5000/uploads

AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OMGS <no-reply@omgs.in>"
